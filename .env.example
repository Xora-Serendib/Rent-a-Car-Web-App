# ==============================================================================
# DANUSHA RENT A CAR — FIREBASE CONFIGURATION (100% FREE SPARK PLAN)
# ==============================================================================
# Instructions to get your free credentials:
# 1. Go to https://console.firebase.google.com/
# 2. Click "Add project" -> Name it "danusha-rent-a-car" -> Free Spark Plan
# 3. Click "Build" -> "Firestore Database" -> "Create Database" (Start in test mode or production)
# 4. Click Project Settings (gear icon) -> "Your apps" -> Web app (</>) -> Register app
# 5. Copy the configuration values into your local .env or Vercel Environment Variables:

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=danusha-rent-a-car.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=danusha-rent-a-car
VITE_FIREBASE_STORAGE_BUCKET=danusha-rent-a-car.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Optional: URL of your separate Danusha Owner Admin Portal on Vercel
VITE_ADMIN_PORTAL_URL=https://danusha-rent-a-car-admin.vercel.app
